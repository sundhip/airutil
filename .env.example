# ==============================================================================
# Airutil Environment Configuration Example
# Generate production secrets using:
#   SECRET_KEY: $(openssl rand -hex 32)
#   POSTGRES_PASSWORD: $(openssl rand -hex 16)
#   INTERNAL_API_TOKEN: $(openssl rand -hex 32)
# ==============================================================================

POSTGRES_USER=airutil
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=airutil

SECRET_KEY=replace_with_generated_64char_hex_key
STORAGE_PATH=/vault_storage

# Docker Terminal Showcase (Phase 6B)
# Set to false in public deployments to completely disable terminal access
SHOWCASE_ENABLED=false
INTERNAL_API_TOKEN=replace_with_internal_secret_token
