# ==============================================================================
# Airutil Environment Configuration Example
# Local development defaults (pre-configured for instant zero-config startup)
# For production deployments, replace with unique 32+ character secrets.
# ==============================================================================

POSTGRES_USER=airutil
POSTGRES_PASSWORD=airutil_secure_vault_2026
POSTGRES_DB=airutil

SECRET_KEY=airutil_super_secret_session_key_production_grade_32bytes
STORAGE_PATH=/vault_storage

# Docker Terminal Showcase (Phase 6B)
SHOWCASE_ENABLED=true
INTERNAL_API_TOKEN=airutil_internal_telemetry_token_64bytes_production
